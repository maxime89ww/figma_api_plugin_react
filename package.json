{
  "name": "figma-api-plugin",
  "version": "1.0.0",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "run-s build:ui build:plugin",
    "build:ui": "vite build && node scripts/inline-ui.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "watch": "vite build --watch",
    "test": "tsc --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@figma/plugin-typings": "^1.129.0",
    "@vitejs/plugin-react": "^5.1.2",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tslib": "^2.3.0",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
